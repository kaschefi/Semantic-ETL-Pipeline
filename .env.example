# ==========================================
# Semantic ETL Pipeline Configuration Blueprint
# ==========================================

# Server & CORS Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Primary LLM & Vision Provider: Azure AI Foundry
AZURE_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_MODEL_NAME=gpt-4.1-nano
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Vector Database: Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=semantic-etl-index

# Fallback LLM & Vision Provider: Groq Cloud AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Local Ollama Service Configuration (Optional fallback)
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=mxbai-embed-large
TEXT_MODEL=llama3
VISION_MODEL=llava

# Pipeline Processing & Semantic Chunking Parameters
MAX_CHUNK_CHARS=1200
OVERLAP_ELEMENTS=1
CONCURRENCY_LIMIT=10
